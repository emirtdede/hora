<UserControl x:Class="Hora.UI.Controls.DonutChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="190" Height="190">
    <Grid>
        <Canvas x:Name="Ring" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="CenterTop" Text="Bugün" FontSize="11" Foreground="{DynamicResource AppMuted}" Opacity="0.85" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CenterTotal" Text="0 dk" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppFg}" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
