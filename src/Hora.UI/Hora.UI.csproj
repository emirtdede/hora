<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Hora</AssemblyName>
    <RootNamespace>Hora.UI</RootNamespace>
    <ApplicationIcon>..\..\assets\hora.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Hora</Product>
    <Description>Kullanim takibi widget</Description>
    <Company>Hora</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hora.Core\Hora.Core.csproj" />
    <ProjectReference Include="..\Hora.Storage\Hora.Storage.csproj" />
  </ItemGroup>

</Project>
