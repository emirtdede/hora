<Window x:Class="Hora.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Hora.UI.Platform"
        Title="Hora"
        Width="1180" Height="780" MinWidth="940" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource BrushBackground}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        SnapsToDevicePixels="True" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Border x:Name="TitleMark" Width="22" Height="22" CornerRadius="6"
                        Background="{DynamicResource BrushAccent}" />
                <TextBlock Text="Hora" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontHeading}" FontWeight="SemiBold" />
                <Border Background="{DynamicResource BrushAccentFaint}" CornerRadius="5" Padding="7,2"
                        Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleVersion" FontSize="{StaticResource FontMicro}"
                               Foreground="{DynamicResource BrushAccent}" Text="1.0.0" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Style="{StaticResource WindowButton}" Click="GoSettings_Click" ToolTip="{Binding [navSettings], Source={x:Static local:LocalizationProxy.Instance}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconSettings}" Width="16" Height="16" />
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="{Binding [railHide], Source={x:Static local:LocalizationProxy.Instance}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconMinimize}" Width="16" Height="16" />
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="Close_Click"
                        ToolTip="{Binding [commonClose], Source={x:Static local:LocalizationProxy.Instance}}"
                        AutomationProperties.Name="{Binding [commonClose], Source={x:Static local:LocalizationProxy.Instance}}">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconClose}" Width="15" Height="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- First side menu: destinations -->
            <Border Grid.Column="0" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="40" Height="40" CornerRadius="11" Margin="0,10,0,14"
                            Background="{DynamicResource BrushAccentFaint}" HorizontalAlignment="Center">
                        <Border x:Name="RailMark" Width="20" Height="20" CornerRadius="5"
                                Background="{DynamicResource BrushAccent}" />
                    </Border>

                    <StackPanel Grid.Row="1" x:Name="DestinationList" />

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button x:Name="BtnRailPause" Style="{StaticResource RailButton}" Click="TogglePause_Click"
                                ToolTip="{Binding [railPause], Source={x:Static local:LocalizationProxy.Instance}}">
                            <Path x:Name="PauseIcon" Style="{StaticResource Icon}" Data="{StaticResource IconPause}" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" Click="GoSettings_Click"
                                ToolTip="{Binding [railOpenSettings], Source={x:Static local:LocalizationProxy.Instance}}">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconTune}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Second side menu: contextual panel -->
            <Border Grid.Column="1" Background="{DynamicResource BrushBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,1,0">
                <Grid Margin="16,16,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="RailTitle" Style="{StaticResource HeadingText}" />
                        <TextBlock x:Name="RailSubtitle" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RailContent" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="11"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="RailFooterTitle" Style="{StaticResource LabelText}" />
                                <TextBlock x:Name="RailFooterBody" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <ScrollViewer Grid.Column="2" x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0">
                <ContentControl x:Name="PageHost" />
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource BrushSuccess}" />
                    <TextBlock x:Name="StatusText" Margin="7,0,0,0" FontSize="{StaticResource FontSmall}"
                               Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="StatusTotal" Margin="16,0,0,0"
                           FontSize="{StaticResource FontSmall}" Foreground="{DynamicResource BrushMuted}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="3" x:Name="StatusMeta" FontSize="{StaticResource FontMicro}"
                           Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Toast -->
        <Border x:Name="ToastHost" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,44"
                Background="{DynamicResource BrushSurface}" CornerRadius="10"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                MaxWidth="420" IsHitTestVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource BrushAccent}" CornerRadius="10,0,0,10" />
                <TextBlock Grid.Column="1" x:Name="ToastText" Margin="14,11" TextWrapping="Wrap"
                           FontSize="{StaticResource FontSmall}" Foreground="{DynamicResource BrushForeground}" />
            </Grid>
        </Border>
    </Grid>
</Window>
