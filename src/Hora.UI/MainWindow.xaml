<Window x:Class="Hora.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Hora.UI.Controls"
        xmlns:conv="clr-namespace:Hora.UI.Converters"
        Title="Hora" Height="440" Width="352"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        MinWidth="272" MinHeight="320" MaxWidth="800" MaxHeight="900"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <SolidColorBrush x:Key="AppFg" Color="White"/>
        <SolidColorBrush x:Key="AppMuted" Color="#9AA3C7"/>
        <SolidColorBrush x:Key="AppCard" Color="#10132A"/>
        <SolidColorBrush x:Key="AppBorder" Color="#2A3050"/>
        <SolidColorBrush x:Key="AppTrack" Color="#222845"/>
        <SolidColorBrush x:Key="AppAccent" Color="#7C8CF8"/>
        <SolidColorBrush x:Key="AppOnAccent" Color="#FFFFFF"/>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppTrack}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PremiumSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="20">
                            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource AppTrack}"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AppAccent}"
                                                         Stroke="{DynamicResource AppCard}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PremiumCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppFg}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="5"
                                    Background="{DynamicResource AppTrack}"
                                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
                                <Path x:Name="Tick" Data="M3,8.5 L7,12.5 L13,3.5" Stroke="{DynamicResource AppOnAccent}"
                                      StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="11" Height="11" Stretch="Uniform" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AppAccent}"/>
                                <Setter TargetName="Box" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="10" CornerRadius="20" Background="{DynamicResource AppCard}"
            BorderBrush="{DynamicResource AppBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="19" VerticalAlignment="Top" Height="120" IsHitTestVisible="False" Margin="1,1,1,0"
                    Grid.RowSpan="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#14FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="DragBar" Grid.Row="0" Background="Transparent" CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="DragBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="11" Height="11" Fill="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                        <TextBlock Text="Hora" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppFg}" Margin="9,0,0,1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Padding="7,6" Click="Hide_Click"
                                ToolTip="Tepsiye al" AutomationProperties.Name="Tepsiye al">
                            <Path Data="M4,8 H16" Stroke="{DynamicResource AppMuted}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="7,6" Margin="2,0,0,0"
                                Click="SettingsToggle_Click" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar">
                            <Path Data="M12,8.5 A3.5,3.5 0 1,0 12,15.5 A3.5,3.5 0 1,0 12,8.5 M19.4,13.5 A7.5,7.5 0 0,0 19.5,12 A7.5,7.5 0 0,0 19.4,10.5 L21.3,9 L20.3,7.2 L18.1,8 A7.5,7.5 0 0,0 16.4,6.9 L16.1,4.5 L14.1,4.5 L13.8,6.9 A7.5,7.5 0 0,0 12,7.5 A7.5,7.5 0 0,0 10.2,6.9 L9.9,4.5 L7.9,4.5 L7.6,6.9 A7.5,7.5 0 0,0 5.9,8 L3.7,7.2 L2.7,9 L4.6,10.5 A7.5,7.5 0 0,0 4.5,12 A7.5,7.5 0 0,0 4.6,13.5 L2.7,15 L3.7,16.8 L5.9,16 A7.5,7.5 0 0,0 7.6,17.1 L7.9,19.5 L9.9,19.5 L10.2,17.1 A7.5,7.5 0 0,0 12,16.5 A7.5,7.5 0 0,0 13.8,17.1 L14.1,19.5 L16.1,19.5 L16.4,17.1 A7.5,7.5 0 0,0 18.1,16 L20.3,16.8 L21.3,15 Z"
                                  Stroke="{DynamicResource AppMuted}" StrokeThickness="1.4" Fill="Transparent"
                                  Width="17" Height="17" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,0,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource AppTrack}" CornerRadius="11" Padding="3" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnMini" Grid.Column="0" Style="{StaticResource SegmentButton}" Content="Mini" Click="ViewMini_Click"/>
                        <Button x:Name="BtnIndex" Grid.Column="1" Style="{StaticResource SegmentButton}" Content="Liste" Click="ViewIndex_Click"/>
                        <Button x:Name="BtnSpectrum" Grid.Column="2" Style="{StaticResource SegmentButton}" Content="Grafik" Click="ViewSpectrum_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" x:Name="SettingsPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="Ayarlar" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppFg}" Margin="0,0,0,6"/>
                        <TextBlock Text="Saydamlık" Foreground="{DynamicResource AppMuted}" FontSize="11.5" Margin="0,0,0,2"/>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource PremiumSlider}"
                                Minimum="0.4" Maximum="1.0" Value="0.96" Margin="0,0,0,12" ValueChanged="OpacitySlider_ValueChanged"/>
                        <CheckBox x:Name="AutostartBox" Style="{StaticResource PremiumCheck}"
                                  Content="Windows açılışında başlat" Margin="0,0,0,10"
                                  Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                        <TextBlock Text="Tema" Foreground="{DynamicResource AppMuted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Tag="Black" Click="ThemeSwatch_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="SwatchBlack" CornerRadius="11" Background="{DynamicResource AppTrack}"
                                            BorderBrush="Transparent" BorderThickness="1" Padding="4">
                                        <Border CornerRadius="7" Background="#26262E"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="Siyah" Foreground="{DynamicResource AppMuted}"
                                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Tag="White" Click="ThemeSwatch_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="3,0,3,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="SwatchWhite" CornerRadius="11" Background="{DynamicResource AppTrack}"
                                            BorderBrush="Transparent" BorderThickness="1" Padding="4">
                                        <Border CornerRadius="7" Background="#FFFFFF"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="Beyaz" Foreground="{DynamicResource AppMuted}"
                                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" Tag="Glass" Click="ThemeSwatch_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="SwatchGlass" CornerRadius="11" Background="{DynamicResource AppTrack}"
                                            BorderBrush="Transparent" BorderThickness="1" Padding="4">
                                        <Border CornerRadius="7">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Offset="0" Color="#FFFFFF"/>
                                                    <GradientStop Offset="0.55" Color="#9AA0B5"/>
                                                    <GradientStop Offset="1" Color="#3A3F55"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="Cam" Foreground="{DynamicResource AppMuted}"
                                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <Border Background="{DynamicResource AppTrack}" CornerRadius="11" Padding="12,8">
                            <TextBlock Text="Film, oyun ve toplantı algılama her zaman açıktır. Veriler yalnızca bu bilgisayarda saklanır, ağa gönderilmez. Sessiz film ve bazı kamera durumları sistem kısıtı nedeniyle yakalanamayabilir."
                                       Foreground="{DynamicResource AppMuted}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1" x:Name="ContentPanel">
                    <StackPanel x:Name="MiniPanel" Visibility="Collapsed">
                        <TextBlock Text="En çok kullandıkların" Foreground="{DynamicResource AppMuted}" FontSize="11.5" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="MiniList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AppTrack}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource AppMuted}"
                                                       FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="7"
                                                Background="{DynamicResource AppTrack}" VerticalAlignment="Center">
                                            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Icon}" Width="18" Height="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Label}" Foreground="{DynamicResource AppFg}"
                                                   FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" Foreground="{DynamicResource AppMuted}"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="MiniEmpty" Text="Henüz veri yok. Bilgisayarı normal kullan, süreler burada birikir."
                                   Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <Grid x:Name="IndexPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TotalText" Text="Bugün: 0 dk" Foreground="{DynamicResource AppFg}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <ItemsControl x:Name="IndexList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                </Grid.RowDefinitions>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="7"
                                                            Background="{DynamicResource AppTrack}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding Icon}" Width="18" Height="18"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource AppFg}"
                                                               FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource AppMuted}"
                                                               FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Grid.Row="1" Background="{DynamicResource AppTrack}" CornerRadius="2.5">
                                                    <Border Background="{Binding Color}" CornerRadius="2.5" HorizontalAlignment="Left"
                                                            Width="{Binding Percent, Converter={StaticResource PercentToWidthConverter}}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="IndexEmpty" Text="Bugün için kayıt yok. Uygulamaları kullandıkça liste dolar."
                                           Foreground="{DynamicResource AppMuted}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ScrollViewer x:Name="SpectrumPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <controls:DonutChart x:Name="Donut" HorizontalAlignment="Center"/>
                        <ItemsControl x:Name="LegendList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{DynamicResource AppFg}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource AppMuted}"
                                                   FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{DynamicResource AppTrack}" CornerRadius="11" Padding="12,9" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Son 7 gün" Foreground="{DynamicResource AppMuted}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WeekText" Grid.Column="1" Text="0 dk" Foreground="{DynamicResource AppFg}"
                                           FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="16,0">
                <Border Height="1" Background="{DynamicResource AppTrack}" VerticalAlignment="Top"/>
                <TextBlock x:Name="FooterText" Text="Yerel kayıt • Ağ yok" FontSize="10"
                           Foreground="{DynamicResource AppMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Stretch" HorizontalAlignment="Right" Width="8"
                    Background="Transparent" Cursor="SizeWE" MouseLeftButtonDown="ResizeRight_Start" Margin="0,20,0,20"/>
            <Border Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="8"
                    Background="Transparent" Cursor="SizeNS" MouseLeftButtonDown="ResizeBottom_Start" Margin="20,0,20,0"/>
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="18" Height="18"
                    Background="Transparent" Cursor="SizeNWSE" MouseLeftButtonDown="ResizeCorner_Start"/>
            <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Text="◢" FontSize="10"
                       Foreground="{DynamicResource AppMuted}" Margin="0,0,14,12" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
