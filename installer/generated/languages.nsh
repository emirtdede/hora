LangString INSTALLER_SECTION_NAME_DESKTOP ${LANG_SIMPCHINESE} "桌面快捷方式"
LangString INSTALLER_SECTION_NAME_STARTUP ${LANG_SIMPCHINESE} "从Windows开始"
