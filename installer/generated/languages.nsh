LangString INSTALLER_WELCOME_INTRO ${LANG_ENGLISH} "This wizard installs Hora, a local-first screen time tracker."
LangString INSTALLER_WELCOME_PRIVACY ${LANG_ENGLISH} "Hora stores usage data only on this PC. No account, no telemetry, no cloud server."
LangString INSTALLER_WELCOME_PUBLISHER ${LANG_ENGLISH} "Publisher: Vellium"
LangString INSTALLER_RUN_TEXT ${LANG_ENGLISH} "Start Hora"
LangString INSTALLER_SECTION_APP ${LANG_ENGLISH} "Hora application files."
LangString INSTALLER_SECTION_START ${LANG_ENGLISH} "Create a Start menu shortcut."
LangString INSTALLER_SECTION_DESKTOP ${LANG_ENGLISH} "Create a desktop shortcut."
LangString INSTALLER_SECTION_STARTUP ${LANG_ENGLISH} "Start Hora silently in the tray when Windows starts."
LangString INSTALLER_SECTION_NAME_START ${LANG_ENGLISH} "Start menu shortcut"
LangString INSTALLER_SECTION_NAME_DESKTOP ${LANG_ENGLISH} "Desktop shortcut"
LangString INSTALLER_SECTION_NAME_STARTUP ${LANG_ENGLISH} "Start with Windows"
LangString INSTALLER_ALREADY_INSTALLED ${LANG_ENGLISH} "Hora is already installed. Remove the previous version and continue?"
LangString INSTALLER_REQUIRES_WINDOWS10 ${LANG_ENGLISH} "Hora requires Windows 10 or newer."
LangString INSTALLER_UNINSTALL_CONFIRM ${LANG_ENGLISH} "Remove Hora from this PC? Your usage data is kept unless you delete it from Settings."
LangString INSTALLER_FINISH_TEXT ${LANG_ENGLISH} "Installation is complete. Click Finish to close this wizard."
LangString INSTALLER_FINISH_TITLE ${LANG_ENGLISH} "Installation complete"

